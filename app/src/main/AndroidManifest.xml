<?xml version="1.0" encoding="utf-8"?>
<!--
  AngaeBot Bridge v0.1 전체 기능:
  1. 공식 NotificationListenerService API로 카카오톡(com.kakao.talk)의 알림만 감지한다.
  2. 명시적인 채팅방 + 발신자 허용목록과 호출어를 모두 통과한 경우만 실행한다.
  3. '테스트/상태/도움말' 명령에 대해 RemoteInput 빠른 답장을 시도한다.
  4. SQLite로 수신·차단·중복·응답·예외 이벤트를 보관하고 UI에서 확인·내보낸다.
  5. 기본 자동응답 OFF, 허용목록 비어 있음; 인터넷·SMS·접근성·저장소 권한 불필요.
  6. 알림만으로는 실제 카카오 사용자 신원 확인이 불가능하므로 강력한 인증 아님.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="@string/app_name"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false"
        android:supportsRtl="true">

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".KakaoNotificationListener"
            android:label="@string/service_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService"/>
            </intent-filter>
            <meta-data
                android:name="android.service.notification.default_filter_types"
                android:value="conversations|alerting" />
        </service>
    </application>
</manifest>
