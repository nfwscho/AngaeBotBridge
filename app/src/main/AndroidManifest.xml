<?xml version="1.0" encoding="utf-8"?>
<!--
  AngaeBot Bridge v0.1 전체 기능:
  1. 공식 NotificationListenerService API로 카카오톡(com.kakao.talk)의 알림만 감지한다.
  2. 명시적인 채팅방 + 발신자 허용목록과 호출어를 모두 통과한 경우만 실행한다.
  3. '테스트/상태/도움말' 명령에 대해 RemoteInput 빠른 답장을 시도한다.
  4. SQLite로 수신·차단·중복·응답·예외 이벤트를 보관하고 UI에서 확인·내보낸다.
  5. 기본 자동응답 OFF, 허용목록 비어 있음; v0.2.0은 loopback Python을 위해 INTERNET만 추가하며 SMS/접근성/저장소 권한은 요구하지 않음.
  7. Python 연결 기본 OFF; localhost 외 HTTP는 허용하지 않는다.
  6. 알림만으로는 실제 카카오 사용자 신원 확인이 불가능하므로 강력한 인증 아님.
  8. 명시적으로 이미지 MIME을 허용한 알림 시험에서만 앱 캐시의 고정 PNG/JPEG를 제공하는 비공개 읽기 전용 Provider를 추가한다.
  9. 기존 첫 단계 시험은 외부 저장소/접근성 권한 없이 동작하며 알림·설정·로그를 보존한다.
  10. 후속 실험에서 접근성 서비스를 명시적으로 별도 추가한다. 사용자가 직접 켜고 이미지 전송 스위치를 켠 경우에만 실행한다.
  11. 정확한 방/사진 UI 확인 실패 시 중단하며 일반 알림 텍스트 답장과 Python Core를 변경하지 않는다.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="@string/app_name"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true">

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name=".ImageReplyProvider"
            android:authorities="${applicationId}.imageprovider"
            android:exported="false"
            android:grantUriPermissions="true" />

        <service
            android:name=".KakaoImageAccessibilityService"
            android:label="앙개봇 이미지 공유 실험"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/image_auto_accessibility" />
        </service>

        <service
            android:name=".KakaoNotificationListener"
            android:label="@string/service_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService"/>
            </intent-filter>
            <meta-data
                android:name="android.service.notification.default_filter_types"
                android:value="conversations|alerting" />
        </service>
    </application>
</manifest>
