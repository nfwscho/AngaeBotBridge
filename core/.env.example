# Create by scripts/install-termux.sh. Do not commit a real token.
ANGAE_TOKEN=replace_with_a_random_64_character_hex_token

# AngaeBot AI v0.3.0 — 기본 OFF. 실제 값은 configure-ai.py를 사용해 .env에 저장하세요.
# OpenAI API 키와 ChatGPT Plus 구독은 별개이며 API는 별도로 과금될 수 있습니다.
ANGAE_AI_ENABLED=0
ANGAE_AI_PROVIDER=openai
ANGAE_AI_BASE_URL=https://api.openai.com/v1
ANGAE_AI_MODEL=gpt-6-luna
ANGAE_AI_API_KEY=
ANGAE_AI_TIMEOUT=15
ANGAE_AI_MEMORY_ENABLED=1
ANGAE_AI_CONTEXT_TURNS=6

# 국토교통부 아파트 매매/전월세 실거래가 무료 공공데이터 API
# https://www.data.go.kr/data/15126469/openapi.do (매매)
# https://www.data.go.kr/data/15126474/openapi.do (전월세)
# 서비스키는 실기기 S20+의 기존 .env에만 설정하고 저장소에 커밋하지 마세요.
MOLIT_API_KEY=
